# Optional: copy this file to .env beside compose.yaml to change defaults.
# Never commit the resulting .env.

# Pin releases (for example 0.1.0). The source checkout defaults to latest;
# downloadable release bundles replace this default with their release tag.
PRASHNA_IMAGE_TAG=latest

# Optional cookie-signing key. Leave unset: the server generates one into the
# data volume on first start and reuses it.
# PRASHNA_SECRET_KEY=

# Optional fixed first-admin setup token. Leave unset: on first start the
# server prints a one-time setup link (`docker compose logs prashna`).
# PRASHNA_SETUP_TOKEN=

# Local endpoint. Change BIND_ADDR to 0.0.0.0 only when LAN access is intended.
PRASHNA_BIND_ADDR=127.0.0.1
PRASHNA_PORT=8000

# 0 for direct localhost. Set to 1 before `ngrok http 8000` so rate limiting
# uses the client IP recorded by ngrok rather than the tunnel peer.
PRASHNA_TRUSTED_PROXY_HOPS=0

# Emergency rate-limit kill switch only. Leave unset for normal operation.
# PRASHNA_RATELIMIT=off
