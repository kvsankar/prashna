# Optional: copy this file to .env beside compose.yaml, then remove the
# "# " in front of each setting you want to change. A copy with no other
# change sets nothing. Never commit the resulting .env.

# HTTPS on your own domain with Caddy (see "Run on your own server with
# HTTPS" in README.md). Set both lines. The domain's DNS record must point at
# this server, and ports 80 and 443 must be open.
# COMPOSE_FILE=compose.yaml:compose.https.yaml
# PRASHNA_DOMAIN=quiz.example.org

# Host ports for Caddy. Leave unset for 80 and 443. To use one address of the
# server only, give the address too, for example 203.0.113.10:80.
# PRASHNA_HTTP_PORT=80
# PRASHNA_HTTPS_PORT=443

# Image tag. Leave unset: the compose.yaml in a release bundle runs that
# release, and the one in the source checkout runs latest. Set it only to run
# another release. A copied .env then keeps that release after an update.
# PRASHNA_IMAGE_TAG=latest

# Compose project name. Leave unset for "prashna". Change it only when this
# server already runs another Compose project named "prashna".
# COMPOSE_PROJECT_NAME=prashna-quiz

# Optional cookie-signing key. Leave unset: the server generates one into the
# data volume on first start and reuses it.
# PRASHNA_SECRET_KEY=

# Optional fixed first-admin setup token. Leave unset: on first start the
# server prints a one-time setup link (`docker compose logs prashna`).
# PRASHNA_SETUP_TOKEN=

# Address and port of Prashna on this machine (without the HTTPS add-on).
# The default 127.0.0.1 accepts connections from this machine only.
# Warning: PRASHNA_BIND_ADDR=0.0.0.0 publishes plain HTTP to everyone who can
# reach the machine, and Docker's published ports bypass UFW rules. Use it only
# on a trusted local network, never on an internet server.
# PRASHNA_BIND_ADDR=127.0.0.1
# PRASHNA_PORT=8000

# Proxy hops in front of Prashna. Leave unset (0) for direct access. Set it to
# 1 behind one tunnel or reverse proxy, so rate limits use each visitor's
# address. The HTTPS add-on sets 1 itself.
# PRASHNA_TRUSTED_PROXY_HOPS=1

# Emergency rate-limit kill switch only. Leave unset for normal operation.
# PRASHNA_RATELIMIT=off
