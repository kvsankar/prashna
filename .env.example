# Prashna environment configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# Load it when running locally with either:
#   uv run uvicorn app.main:app --reload --port 8000 --env-file .env
#   # or:  set -a; source .env; set +a
# (In Docker, deploy/docker-compose.yml loads /opt/prashna/.env instead.)

# ---------- Required for any real / persistent use ----------
# Signs admin session cookies. Without it a random key is generated on each
# start, so every admin is logged out on restart. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PRASHNA_SECRET_KEY=

# ---------- Storage (optional; defaults are fine for local) ----------
# SQLite DB location (default: <repo>/prashna.db)
# PRASHNA_DB_PATH=./prashna.db
# Uploaded images directory (default: <repo>/uploads)
# PRASHNA_UPLOADS_DIR=./uploads

# ---------- Rate limiting (UC-X-08) ----------
# Trusted reverse-proxy hops for client-IP resolution.
#   0 = use the socket peer (correct for direct localhost)
#   1 = behind ngrok or the bundled nginx (a single hop) — keys limits on the
#       real client IP instead of a spoofable X-Forwarded-For prefix
PRASHNA_TRUSTED_PROXY_HOPS=0
# Emergency kill-switch. Leave unset (on). Set to off/0/false to disable.
# PRASHNA_RATELIMIT=off

# ---------- GitHub OAuth admin login (UC-A-26; optional) ----------
# Enable by setting ALL THREE. Register an OAuth App at
#   github.com -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
# with the Authorization callback URL:
#   https://prashna.sankara.net/api/auth/github/callback   (production)
#   http://localhost:8000/api/auth/github/callback          (local testing)
# PRASHNA_GITHUB_ADMINS is a comma-separated allowlist of GitHub logins.
# Runs alongside password login; the first allowlisted sign-in bootstraps the admin.
# PRASHNA_GITHUB_CLIENT_ID=
# PRASHNA_GITHUB_CLIENT_SECRET=
# PRASHNA_GITHUB_ADMINS=kvsankar
