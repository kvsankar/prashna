# Copy to /opt/prashna/.env on the server and fill in a real secret.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PRASHNA_SECRET_KEY=replace-me-with-a-long-random-string

# Optional overrides (defaults are fine):
# PRASHNA_DB_PATH=/data/prashna.db
# PRASHNA_UPLOADS_DIR=/app/uploads
