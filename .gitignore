__pycache__/
*.pyc
.venv/
.DS_Store

# SQLite DB and journals — contains user accounts, session data.
# (-wal / -shm are the WAL-mode sidecar files created at runtime.)
prashna.db
prashna.db-journal
*.db
*.db-journal
*.db-wal
*.db-shm

# User-uploaded files
uploads/*
!uploads/.gitkeep

# Local env / IDE / tooling
.env
.env.*
!.env.example
.idea/
.vscode/
.claude/
.mcp.json

# Frontend dev-lint tooling (no runtime/build artifacts — dev only)
node_modules/

# Lint / test caches & coverage
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Vite build output (produced by `npm run build`)
prashna/static/

# Local release archives (published artifacts are attached in GitHub Releases)
dist/
